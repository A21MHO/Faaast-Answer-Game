<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>FaaasT Answer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@500;700;900&family=Patrick+Hand&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-blue: #16609c;
      --primary-blue-light: #2078be;
      --primary-blue-dark: #0e416c;
      --footer-navy: #0e385c;
      --bg-outer: #d7dce3;
      --card-bg: #ffffff;
      --text-dark: #111827;
      --text-muted: #6b7280;
      --accent-gold: #f59e0b;
      --accent-green: #10b981;
      --accent-red: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Noto Sans KR', sans-serif;
      background-color: var(--bg-outer);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 20px 14px;
      overflow: hidden;
    }

    /* 메인 앱 컨테이너 */
    #app-frame {
      position: relative;
      width: 100%;
      max-width: 420px;
      height: calc(100vh - 40px);
      height: calc(100dvh - 40px);
      max-height: 780px;
      min-height: 580px;
      background-color: var(--card-bg);
      border-radius: 18px;
      box-shadow: 0 20px 45px rgba(14, 56, 92, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.04);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* 화면 흔들림 및 플래시 효과 */
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-10px) rotate(-0.8deg); }
      40% { transform: translateX(10px) rotate(0.8deg); }
      60% { transform: translateX(-7px); }
      80% { transform: translateX(7px); }
    }
    .shake {
      animation: shake 0.35s cubic-bezier(.36,.07,.19,.97) both;
    }

    #flash-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      z-index: 40;
      transition: opacity 0.25s ease-out;
    }

    /* 공통 화면 전환 */
    .screen {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
      transform: scale(0.98);
      padding: 20px;
    }
    .screen.active {
      opacity: 1;
      pointer-events: auto;
      transform: scale(1);
    }

    /* ==================== 1. 메인 타이틀 화면 ==================== */
    #title-screen {
      justify-content: space-between;
      padding: 0 22px 24px;
    }

    /* 좌측 상단 체커 플래그 일러스트 */
    .flag-wrapper {
      position: absolute;
      top: 0;
      left: 0;
      width: 245px;
      height: 235px;
      pointer-events: none;
      z-index: 1;
      transform-origin: top left;
      animation: flagWave 2.8s ease-in-out infinite alternate;
    }
    @keyframes flagWave {
      0% { transform: skewY(0deg) scale(1); }
      50% { transform: skewY(-1.8deg) scale(1.015, 0.99); }
      100% { transform: skewY(1.2deg) scale(0.995, 1.01); }
    }

    /* 타이틀 영역 */
    .title-header {
      position: relative;
      z-index: 2;
      margin-top: 168px;
      padding-right: 6px;
      text-align: right;
    }
    .game-title {
      font-family: 'Patrick Hand', cursive;
      font-size: 3.35rem;
      line-height: 0.96;
      color: #0f172a;
      letter-spacing: 0.5px;
      text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.05);
    }
    .game-title span {
      display: block;
    }

    .title-divider {
      width: 100%;
      height: 2.5px;
      background-color: #1e293b;
      border-radius: 2px;
      margin-top: 20px;
    }

    /* 최고 기록 배지 영역 */
    .lobby-best-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 14px 0 8px;
      z-index: 2;
    }
    .lobby-best-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #f1f5f9;
      border: 1.5px solid #e2e8f0;
      padding: 7px 16px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #334155;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
    }
    .lobby-best-badge strong {
      color: var(--primary-blue);
      font-weight: 900;
    }

    /* 공통 버튼 인터랙션 모션 */
    .interactive-btn {
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.14s cubic-bezier(0.34, 1.56, 0.64, 1),
                  box-shadow 0.14s ease,
                  background-color 0.15s ease,
                  filter 0.15s ease;
    }
    .interactive-btn::after {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transform: skewX(-20deg);
      transition: left 0.45s ease;
      pointer-events: none;
    }
    .interactive-btn:hover {
      transform: translateY(-2.5px) scale(1.012);
      filter: brightness(1.06);
    }
    .interactive-btn:hover::after {
      left: 140%;
    }
    .interactive-btn:active {
      transform: translateY(3px) scale(0.975);
      filter: brightness(0.95);
    }

    /* 메인 메뉴 버튼 그룹 */
    .menu-buttons {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: auto;
      margin-bottom: 18px;
      z-index: 2;
    }

    .arcade-btn {
      width: 100%;
      padding: 15px 20px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(180deg, var(--primary-blue-light) 0%, var(--primary-blue) 100%);
      color: #ffffff;
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.3px;
      box-shadow: 0 4px 0 var(--primary-blue-dark), 0 8px 16px rgba(22, 96, 156, 0.22);
    }
    .arcade-btn:hover {
      box-shadow: 0 6px 0 var(--primary-blue-dark), 0 12px 20px rgba(22, 96, 156, 0.28);
    }
    .arcade-btn:active {
      box-shadow: 0 1px 0 var(--primary-blue-dark), 0 3px 6px rgba(22, 96, 156, 0.2);
    }

    /* 하단 제작자 & 버전 바 */
    .footer-bar {
      background-color: var(--footer-navy);
      color: #ffffff;
      border-radius: 10px;
      padding: 9px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.2px;
      box-shadow: 0 4px 10px rgba(14, 56, 92, 0.15);
    }

    /* ==================== 2. 카운트다운 오버레이 ==================== */
    #countdown-overlay {
      position: absolute;
      inset: 0;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(4px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 30;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    #countdown-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    #countdown-text {
      font-family: 'Patrick Hand', cursive;
      font-size: 6rem;
      color: var(--primary-blue);
      animation: popScale 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .countdown-sub {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-top: 8px;
    }
    @keyframes popScale {
      0% { transform: scale(0.3); opacity: 0; }
      70% { transform: scale(1.15); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }

    /* ==================== 3. 아케이드 본게임 화면 ==================== */
    #game-screen {
      justify-content: space-between;
      padding: 18px 20px 22px;
      background: linear-gradient(180deg, #f8fafc 0%, #ffffff 35%);
    }

    /* 상단 HUD */
    .game-hud {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .hud-stats {
      display: flex;
      gap: 8px;
      flex: 1;
    }
    .stat-box {
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      padding: 6px 10px;
      flex: 1;
      box-shadow: 0 2px 5px rgba(0,0,0,0.03);
    }
    .stat-label {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
    }
    .stat-value {
      font-size: 1.15rem;
      font-weight: 900;
      color: var(--text-dark);
      line-height: 1.2;
    }
    .stat-value.best {
      color: var(--primary-blue);
    }

    .sound-btn {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      border: 1.5px solid #e2e8f0;
      background: #ffffff;
      font-size: 1.2rem;
      display: flex;
      justify-content: center;
      align-items: center;
      box-shadow: 0 2px 5px rgba(0,0,0,0.04);
    }

    /* 타이머 바 */
    .timer-section {
      margin-top: 12px;
    }
    .timer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 5px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
    }
    #timer-text {
      font-variant-numeric: tabular-nums;
      font-weight: 900;
      color: var(--primary-blue);
    }
    .timer-track {
      width: 100%;
      height: 14px;
      background-color: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.12);
    }
    #timer-fill {
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, #16609c, #2589d8);
      border-radius: 999px;
      transition: width 0.08s linear, background 0.2s ease;
    }
    #timer-fill.danger {
      background: linear-gradient(90deg, #dc2626, #f87171);
    }

    /* 콤보 & 플로팅 피드백 영역 */
    .combo-area {
      position: relative;
      height: 44px;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 6px;
    }
    #combo-badge {
      background: linear-gradient(135deg, #f59e0b, #ea580c);
      color: #fff;
      font-weight: 900;
      font-size: 0.95rem;
      padding: 5px 14px;
      border-radius: 999px;
      box-shadow: 0 4px 10px rgba(234, 88, 12, 0.3);
      opacity: 0;
      transform: scale(0.8);
      transition: all 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    #combo-badge.visible {
      opacity: 1;
      transform: scale(1);
    }
    #combo-badge.pulse {
      transform: scale(1.22);
    }

    .floating-toast {
      position: absolute;
      font-weight: 900;
      font-size: 1rem;
      pointer-events: none;
      animation: floatUp 0.75s ease-out forwards;
      z-index: 15;
    }
    @keyframes floatUp {
      0% { opacity: 1; transform: translateY(0) scale(0.9); }
      100% { opacity: 0; transform: translateY(-28px) scale(1.1); }
    }

    /* 중앙 문제 출제 카드 */
    .question-card {
      flex: 1;
      margin: 8px 0 16px;
      background: #ffffff;
      border: 2.5px solid #1e293b;
      border-radius: 18px;
      box-shadow: 0 6px 0 #1e293b, 0 12px 24px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
    }
    .question-hint {
      position: absolute;
      top: 12px;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.5px;
    }
    #question-text {
      font-family: 'Patrick Hand', 'Noto Sans KR', sans-serif;
      font-size: 4.1rem;
      font-weight: 700;
      color: #0f172a;
      letter-spacing: 2px;
    }

    /* 하단 3개 보기 버튼 */
    .choices-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .choice-btn {
      position: relative;
      height: 86px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(180deg, var(--primary-blue-light) 0%, var(--primary-blue) 100%);
      color: #ffffff;
      font-family: 'Patrick Hand', 'Noto Sans KR', sans-serif;
      font-size: 2.2rem;
      font-weight: 700;
      box-shadow: 0 5px 0 var(--primary-blue-dark), 0 8px 14px rgba(22, 96, 156, 0.22);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .choice-btn:hover {
      box-shadow: 0 7px 0 var(--primary-blue-dark), 0 12px 18px rgba(22, 96, 156, 0.28);
    }
    .choice-btn:active, .choice-btn.pressed {
      transform: translateY(4px) scale(0.96);
      box-shadow: 0 1px 0 var(--primary-blue-dark);
    }
    .choice-btn.correct-flash {
      background: linear-gradient(180deg, #34d399 0%, #059669 100%);
      box-shadow: 0 5px 0 #065f46;
    }
    .choice-btn.wrong-flash {
      background: linear-gradient(180deg, #f87171 0%, #dc2626 100%);
      box-shadow: 0 5px 0 #991b1b;
    }
    .key-badge {
      position: absolute;
      top: 6px;
      left: 8px;
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      background: rgba(255, 255, 255, 0.2);
      padding: 1px 5px;
      border-radius: 4px;
    }

    /* ==================== 4. 게임 오버 화면 ==================== */
    #gameover-screen {
      justify-content: space-between;
      align-items: center;
      text-align: center;
      padding: 24px 22px 24px;
      overflow-y: auto;
    }
    .gameover-top {
      width: 100%;
      margin-top: 4px;
    }
    .gameover-tag {
      display: inline-block;
      background: #fee2e2;
      color: #dc2626;
      font-weight: 900;
      font-size: 0.78rem;
      padding: 4px 12px;
      border-radius: 999px;
      letter-spacing: 0.5px;
    }
    .gameover-title {
      font-family: 'Patrick Hand', cursive;
      font-size: 3.1rem;
      color: #0f172a;
      margin-top: 2px;
      line-height: 1.05;
    }

    .result-card {
      position: relative;
      width: 100%;
      background: #f8fafc;
      border: 2px solid #e2e8f0;
      border-radius: 16px;
      padding: 22px 16px 18px;
      margin: 14px 0;
    }
    #new-record-badge {
      display: none;
      position: absolute;
      top: -13px;
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #ffffff;
      font-size: 0.74rem;
      font-weight: 900;
      padding: 4px 14px;
      border-radius: 999px;
      box-shadow: 0 4px 10px rgba(217, 119, 6, 0.32);
    }
    #new-record-badge.show {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      animation: popScale 0.4s ease;
    }

    .final-score-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-muted);
    }
    .final-score-val {
      font-size: 3rem;
      font-weight: 900;
      color: var(--primary-blue);
      line-height: 1.1;
      margin: 4px 0 14px;
    }
    .result-sub-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      border-top: 1.5px solid #e2e8f0;
      padding-top: 12px;
    }
    .result-sub-item {
      background: #ffffff;
      padding: 9px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
    }
    .result-sub-item span {
      display: block;
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 700;
    }
    .result-sub-item strong {
      font-size: 1.05rem;
      color: #0f172a;
      font-weight: 900;
    }

    .gameover-actions {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 11px;
      margin-bottom: 4px;
    }
    .arcade-btn.secondary {
      background: linear-gradient(180deg, #475569 0%, #334155 100%);
      box-shadow: 0 4px 0 #1e293b, 0 8px 14px rgba(30, 41, 59, 0.2);
    }
    .arcade-btn.secondary:hover {
      box-shadow: 0 6px 0 #1e293b, 0 12px 18px rgba(30, 41, 59, 0.25);
    }
    .arcade-btn.secondary:active {
      box-shadow: 0 1px 0 #1e293b;
    }

    /* ==================== 5. 모달 (튜토리얼 & 순위표 & 확인창) ==================== */
    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(3px);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      z-index: 50;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .modal-backdrop.active {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-box {
      width: 100%;
      max-width: 350px;
      background: #ffffff;
      border-radius: 16px;
      padding: 22px 20px;
      box-shadow: 0 20px 35px rgba(0, 0, 0, 0.25);
      transform: translateY(14px);
      transition: transform 0.22s ease;
    }
    .modal-backdrop.active .modal-box {
      transform: translateY(0);
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 10px;
      margin-bottom: 14px;
    }
    .modal-title {
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--footer-navy);
    }
    .modal-close {
      background: #f1f5f9;
      border: none;
      width: 30px;
      height: 30px;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 900;
      color: #475569;
    }

    .tutorial-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 0.88rem;
      color: #334155;
      line-height: 1.45;
      margin-bottom: 18px;
    }
    .tutorial-list li {
      background: #f8fafc;
      padding: 10px 12px;
      border-radius: 10px;
      border-left: 4px solid var(--primary-blue);
    }
    .tutorial-list li strong {
      color: #0f172a;
      display: block;
      margin-bottom: 2px;
    }

    .rank-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
      max-height: 240px;
      overflow-y: auto;
    }
    .rank-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 12px;
      background: #f8fafc;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 700;
    }
    .rank-item.top-1 {
      background: #fef3c7;
      border: 1.5px solid #f59e0b;
    }
    .rank-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .rank-num {
      width: 24px;
      height: 24px;
      border-radius: 6px;
      background: var(--primary-blue);
      color: #fff;
      font-size: 0.8rem;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: 900;
    }
    .rank-item.top-1 .rank-num {
      background: #d97706;
    }
    .rank-date {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 500;
    }
    .rank-score {
      font-weight: 900;
      color: var(--primary-blue);
      font-size: 1rem;
    }
    .empty-rank {
      text-align: center;
      padding: 24px 0;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
    .modal-footer-btns {
      display: flex;
      gap: 8px;
    }
    .btn-small {
      flex: 1;
      padding: 11px;
      border: none;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.92rem;
      background: var(--primary-blue);
      color: #fff;
      box-shadow: 0 3px 0 var(--primary-blue-dark);
    }
    .btn-small.danger {
      background: #fee2e2;
      color: #dc2626;
      box-shadow: 0 3px 0 #fca5a5;
    }
    .confirm-desc {
      font-size: 0.92rem;
      color: #334155;
      line-height: 1.5;
      margin-bottom: 18px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div id="app-frame">
    <div id="flash-overlay"></div>

