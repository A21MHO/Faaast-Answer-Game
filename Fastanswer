  <script>
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }
      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioCtx();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }
      toggle() {
        this.enabled = !this.enabled;
        return this.enabled;
      }
      playTone(freq, type, duration, startTime = 0, gainVal = 0.16) {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime + startTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(gainVal, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + duration);
      }
      playClick() {
        this.playTone(520, 'sine', 0.06, 0, 0.1);
      }
      playCountdown(isGo = false) {
        if (isGo) {
          this.playTone(880, 'triangle', 0.28, 0, 0.22);
        } else {
          this.playTone(440, 'triangle', 0.14, 0, 0.16);
        }
      }
      playCorrect(combo) {
        const baseFreq = Math.min(523.25 + combo * 24, 1046.5);
        this.playTone(baseFreq, 'sine', 0.12, 0, 0.18);
        this.playTone(baseFreq * 1.25, 'triangle', 0.16, 0.05, 0.15);
      }
      playBonus() {
        this.playTone(587.33, 'triangle', 0.1, 0, 0.2);
        this.playTone(783.99, 'triangle', 0.1, 0.07, 0.2);
        this.playTone(1046.5, 'triangle', 0.25, 0.14, 0.22);
      }
      playWrong() {
        this.playTone(165, 'sawtooth', 0.22, 0, 0.2);
        this.playTone(130, 'sawtooth', 0.25, 0.08, 0.18);
      }
      playGameOver() {
        this.playTone(440, 'triangle', 0.18, 0, 0.18);
        this.playTone(392, 'triangle', 0.18, 0.16, 0.18);
        this.playTone(349.23, 'triangle', 0.18, 0.32, 0.18);
        this.playTone(261.63, 'sawtooth', 0.45, 0.48, 0.16);
      }
    }

    const sfx = new SoundEngine();
    const STORAGE_KEY = 'faaast_answer_records_v1';

    function getRecords() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function getBestScore() {
      const records = getRecords();
      return records.length > 0 ? records[0].score : 0;
    }

    function saveRecord(score, maxCombo) {
      if (score <= 0) return false;
      const prevBest = getBestScore();
      const records = getRecords();
      const now = new Date();
      const dateStr = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;
      records.push({ score, maxCombo, date: dateStr });
      records.sort((a, b) => b.score - a.score);
      const top5 = records.slice(0, 5);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(top5));
      return score > prevBest;
    }

    const INITIAL_TIME = 90.0;
    const MAX_TIME_CAP = 90.0;

    let state = {
      isPlaying: false,
      score: 0,
      combo: 0,
      maxCombo: 0,
      timeLeft: INITIAL_TIME,
      currentAnswer: 0,
      choices: [],
      timerInterval: null,
      lastTimestamp: 0
    };

    const appFrame = document.getElementById('app-frame');
    const flashOverlay = document.getElementById('flash-overlay');
    const screens = {
      title: document.getElementById('title-screen'),
      game: document.getElementById('game-screen'),
      gameover: document.getElementById('gameover-screen')
    };

    const countdownOverlay = document.getElementById('countdown-overlay');
    const countdownText = document.getElementById('countdown-text');

    const hudScore = document.getElementById('hud-score');
    const hudBest = document.getElementById('hud-best');
    const hudCombo = document.getElementById('hud-combo');
    const timerText = document.getElementById('timer-text');
    const timerFill = document.getElementById('timer-fill');
    const comboArea = document.getElementById('combo-area');
    const comboBadge = document.getElementById('combo-badge');
    const questionText = document.getElementById('question-text');
    const choiceBtns = document.querySelectorAll('.choice-btn');

    function showScreen(name) {
      Object.values(screens).forEach(s => s.classList.remove('active'));
      screens[name].classList.add('active');
    }

    function updateLobbyBest() {
      const best = getBestScore();
      document.getElementById('lobby-best-score').textContent = best.toLocaleString();
      hudBest.textContent = best.toLocaleString();
    }

    function generateQuestion() {
      const ops = ['+', '-', '×', '÷'];
      const op = ops[Math.floor(Math.random() * ops.length)];
      let a, b, ans, expr;

      if (op === '+') {
        a = Math.floor(Math.random() * 9) + 1;
        b = Math.floor(Math.random() * 9) + 1;
        ans = a + b;
        expr = `${a} + ${b}`;
      } else if (op === '-') {
        a = Math.floor(Math.random() * 9) + 1;
        b = Math.floor(Math.random() * 9) + 1;
        if (a < b) [a, b] = [b, a];
        ans = a - b;
        expr = `${a} - ${b}`;
      } else if (op === '×') {
        a = Math.floor(Math.random() * 9) + 1;
        b = Math.floor(Math.random() * 9) + 1;
        ans = a * b;
        expr = `${a} × ${b}`;
      } else {
        b = Math.floor(Math.random() * 8) + 2;
        ans = Math.floor(Math.random() * 9) + 1;
        a = b * ans;
        expr = `${a} ÷ ${b}`;
      }

      const wrongSet = new Set();
      while (wrongSet.size < 2) {
        const offset = (Math.floor(Math.random() * 5) + 1) * (Math.random() < 0.5 ? 1 : -1);
        const candidate = ans + offset;
        if (candidate >= 0 && candidate !== ans) {
          wrongSet.add(candidate);
        }
      }

      const choices = [ans, ...Array.from(wrongSet)];
      for (let i = choices.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [choices[i], choices[j]] = [choices[j], choices[i]];
      }

      state.currentAnswer = ans;
      state.choices = choices;
      questionText.textContent = expr;

      choiceBtns.forEach((btn, idx) => {
        btn.classList.remove('correct-flash', 'wrong-flash');
        btn.querySelector('.choice-val').textContent = choices[idx];
      });
    }

    function triggerFlash(color) {
      flashOverlay.style.backgroundColor = color;
      flashOverlay.style.opacity = '0.28';
      setTimeout(() => {
        flashOverlay.style.opacity = '0';
      }, 120);
    }

    function spawnToast(text, color) {
      const toast = document.createElement('div');
      toast.className = 'floating-toast';
      toast.textContent = text;
      toast.style.color = color;
      comboArea.appendChild(toast);
      setTimeout(() => toast.remove(), 750);
    }

    function updateHUD() {
      hudScore.textContent = state.score.toLocaleString();
      hudCombo.textContent = state.combo;

      const currentBest = Math.max(getBestScore(), state.score);
      hudBest.textContent = currentBest.toLocaleString();

      if (state.combo >= 2) {
        comboBadge.textContent = `🔥 ${state.combo} COMBO!`;
        comboBadge.classList.add('visible');
        comboBadge.classList.remove('pulse');
        void comboBadge.offsetWidth;
        comboBadge.classList.add('pulse');
      } else {
        comboBadge.classList.remove('visible');
      }
    }

    function updateTimerUI() {
      const clamped = Math.max(0, state.timeLeft);
      timerText.textContent = `${clamped.toFixed(1)}s`;
      const pct = Math.min(100, (clamped / MAX_TIME_CAP) * 100);
      timerFill.style.width = `${pct}%`;

      if (clamped <= 15.0) {
        timerFill.classList.add('danger');
        timerText.style.color = '#dc2626';
      } else {
        timerFill.classList.remove('danger');
        timerText.style.color = 'var(--primary-blue)';
      }
    }

    function handleChoice(index) {
      if (!state.isPlaying) return;
      const selected = state.choices[index];
      const btn = choiceBtns[index];

      if (selected === state.currentAnswer) {
        state.combo += 1;
        if (state.combo > state.maxCombo) state.maxCombo = state.combo;

        const gained = 100 + (state.combo - 1) * 15;
        state.score += gained;

        btn.classList.add('correct-flash');
        triggerFlash('#10b981');

        if (state.combo > 0 && state.combo % 5 === 0) {
          state.timeLeft = Math.min(MAX_TIME_CAP, state.timeLeft + 1.5);
          sfx.playBonus();
          spawnToast(`+${gained}점 · ⏱️ +1.5초 보너스!`, '#d97706');
        } else {
          sfx.playCorrect(state.combo);
          spawnToast(`+${gained}`, '#059669');
        }

        updateHUD();
        updateTimerUI();
        setTimeout(() => {
          if (state.isPlaying) generateQuestion();
        }, 70);
      } else {
        state.combo = 0;
        state.timeLeft = Math.max(0, state.timeLeft - 2.0);

        btn.classList.add('wrong-flash');
        sfx.playWrong();
        triggerFlash('#ef4444');
        spawnToast('오답! -2.0초', '#dc2626');

        appFrame.classList.remove('shake');
        void appFrame.offsetWidth;
        appFrame.classList.add('shake');

        updateHUD();
        updateTimerUI();

        if (state.timeLeft <= 0) {
          endGame();
        }
      }
    }

    function startCountdownAndGame() {
      sfx.init();
      sfx.playClick();
      showScreen('game');

      state.score = 0;
      state.combo = 0;
      state.maxCombo = 0;
      state.timeLeft = INITIAL_TIME;
      updateHUD();
      updateTimerUI();
      generateQuestion();

      let count = 3;
      countdownText.textContent = count;
      countdownOverlay.classList.add('active');
      sfx.playCountdown(false);

      const cdInterval = setInterval(() => {
        count -= 1;
        if (count > 0) {
          countdownText.textContent = count;
          countdownText.style.animation = 'none';
          void countdownText.offsetWidth;
          countdownText.style.animation = 'popScale 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
          sfx.playCountdown(false);
        } else if (count === 0) {
          countdownText.textContent = 'GO!';
          countdownText.style.animation = 'none';
          void countdownText.offsetWidth;
          countdownText.style.animation = 'popScale 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
          sfx.playCountdown(true);
        } else {
          clearInterval(cdInterval);
          countdownOverlay.classList.remove('active');
          beginGameLoop();
        }
      }, 750);
    }

    function beginGameLoop() {
      state.isPlaying = true;
      state.lastTimestamp = performance.now();

      state.timerInterval = setInterval(() => {
        if (!state.isPlaying) return;
        const now = performance.now();
        const delta = (now - state.lastTimestamp) / 1000;
        state.lastTimestamp = now;

        state.timeLeft -= delta;
        if (state.timeLeft <= 0) {
          state.timeLeft = 0;
          updateTimerUI();
          endGame();
        } else {
          updateTimerUI();
        }
      }, 50);
    }

    function endGame() {
      state.isPlaying = false;
      clearInterval(state.timerInterval);
      sfx.playGameOver();

      const isNewBest = saveRecord(state.score, state.maxCombo);
      const best = getBestScore();

      document.getElementById('final-score').textContent = state.score.toLocaleString();
      document.getElementById('gameover-best').textContent = `${best.toLocaleString()} 점`;
      document.getElementById('gameover-max-combo').textContent = `${state.maxCombo} 콤보`;

      const badge = document.getElementById('new-record-badge');
      if (isNewBest && state.score > 0) {
        badge.classList.add('show');
      } else {
        badge.classList.remove('show');
      }

      updateLobbyBest();
      showScreen('gameover');
    }

    function renderLeaderboard() {
      const listEl = document.getElementById('rank-list');
      const records = getRecords();

      if (records.length === 0) {
        listEl.innerHTML = '<li class="empty-rank">아직 등록된 기록이 없습니다.<br>첫 번째 기록에 도전해보세요!</li>';
        return;
      }

      listEl.innerHTML = records.map((rec, idx) => `
        <li class="rank-item ${idx === 0 ? 'top-1' : ''}">
          <div class="rank-left">
            <span class="rank-num">${idx + 1}</span>
            <div>
              <div>최대 ${rec.maxCombo} 콤보</div>
              <div class="rank-date">${rec.date}</div>
            </div>
          </div>
          <div class="rank-score">${rec.score.toLocaleString()} 점</div>
        </li>
      `).join('');
    }

    document.getElementById('btn-start').addEventListener('click', startCountdownAndGame);
    document.getElementById('btn-retry').addEventListener('click', startCountdownAndGame);
    document.getElementById('btn-home').addEventListener('click', () => {
      sfx.playClick();
      updateLobbyBest();
      showScreen('title');
    });

    document.getElementById('btn-tutorial').addEventListener('click', () => {
      sfx.playClick();
      document.getElementById('tutorial-modal').classList.add('active');
    });

    document.getElementById('btn-leaderboard').addEventListener('click', () => {
      sfx.playClick();
      renderLeaderboard();
      document.getElementById('leaderboard-modal').classList.add('active');
    });

    document.getElementById('btn-reset-rank').addEventListener('click', () => {
      sfx.playClick();
      document.getElementById('confirm-reset-modal').classList.add('active');
    });

    document.getElementById('btn-confirm-reset-yes').addEventListener('click', () => {
      sfx.playClick();
      localStorage.removeItem(STORAGE_KEY);
      renderLeaderboard();
      updateLobbyBest();
      document.getElementById('confirm-reset-modal').classList.remove('active');
    });

    document.querySelectorAll('[data-close]').forEach(btn => {
      btn.addEventListener('click', () => {
        sfx.playClick();
        const targetId = btn.getAttribute('data-close');
        document.getElementById(targetId).classList.remove('active');
      });
    });

    document.getElementById('btn-sound').addEventListener('click', (e) => {
      const isOn = sfx.toggle();
      e.currentTarget.textContent = isOn ? '🔊' : '🔇';
      if (isOn) sfx.playClick();
    });

    choiceBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-index'));
        handleChoice(idx);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (!state.isPlaying) return;
      let idx = -1;
      if (e.key === '1' || e.key === 'ArrowLeft') idx = 0;
      else if (e.key === '2' || e.key === 'ArrowDown') idx = 1;
      else if (e.key === '3' || e.key === 'ArrowRight') idx = 2;

      if (idx !== -1) {
        e.preventDefault();
        const btn = choiceBtns[idx];
        btn.classList.add('pressed');
        setTimeout(() => btn.classList.remove('pressed'), 100);
        handleChoice(idx);
      }
    });

    updateLobbyBest();
  </script>
</body>
</html>
